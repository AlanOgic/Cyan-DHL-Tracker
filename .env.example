# DHL API credentials
DHL_API_KEY=your_dhl_api_key

# Odoo connection details (JSON-2 API, Odoo 19+)
ODOO_URL=https://your-odoo-instance.odoo.com
# Optional: only needed when the server hosts several databases
ODOO_DB=your_odoo_database
# API key from Odoo: Preferences > Account Security > New API Key (a dedicated bot user is recommended)
ODOO_API_KEY=your_odoo_api_key

# Mattermost incoming webhook for summary notifications (optional, https only; leave empty to disable)
WEBHOOK_URL=https://your-webhook-endpoint.com/webhook

# Alerts on DHL events that need action (customs, failed delivery, refusal/return/damage, DHL incidents)
# Mattermost incoming webhook for alerts (https only; leave empty to skip Mattermost)
ALERT_WEBHOOK_URL=
# Helpdesk team that gets a ticket only when DHL reports a problem on a shipment;
# a new problem on a shipment whose ticket is still open is added to it as an internal note (empty disables tickets)
HELPDESK_TEAM="Logistics & Shipping"
# Comma-separated tags set on new tickets
HELPDESK_TAGS="Shipping Related"
# Problem codes reported on Mattermost only, without a ticket (on hold, missed delivery cycle, not home)
HELPDESK_SKIP_CODES=OH,MD,NH

# External monitor pinged (GET) after each successful hourly check, so someone is alerted when the
# tracker stops: a healthchecks.io check URL or an Uptime Kuma push URL (https only; leave empty to skip)
HEARTBEAT_URL=

# Docker only: exact host names the tracker may reach through its egress proxy, comma-separated.
# List DHL plus the hosts of ODOO_URL, ALERT_WEBHOOK_URL, WEBHOOK_URL and HEARTBEAT_URL.
EGRESS_ALLOWED_HOSTS=api-eu.dhl.com,your-odoo-instance.odoo.com,your-mattermost.example.com
